# ==============================================================================
# 1. Bronze Database Configuration (Raw Ingestion Layer)
# ==============================================================================
BRONZE_DB_HOST=db_bronze
BRONZE_DB_PORT=5432
BRONZE_DB_HOST_PORT=5433
BRONZE_DB_USER=postgres
BRONZE_DB_PASSWORD=your_secure_bronze_password_here
BRONZE_DB_NAME=bronze_db

# ==============================================================================
# 2. Silver Database Configuration (3NF Clean Relational OLTP)
# ==============================================================================
SILVER_DB_HOST=db_silver
SILVER_DB_PORT=5432
SILVER_DB_HOST_PORT=5432
SILVER_DB_USER=postgres
SILVER_DB_PASSWORD=your_secure_silver_password_here
SILVER_DB_NAME=silver_db

# ==============================================================================
# 3. Gold Database Configuration (Dedicated Analytics & Reporting)
# ==============================================================================
GOLD_DB_HOST=db_gold
GOLD_DB_PORT=5432
GOLD_DB_HOST_PORT=5435
GOLD_DB_USER=postgres
GOLD_DB_PASSWORD=your_secure_gold_password_here
GOLD_DB_NAME=gold_db

# Backwards-compatibility aliases
POSTGRES_HOST=db_silver
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_silver_password_here
POSTGRES_DB=silver_db

# ==============================================================================
# 4. Redis Cache Configuration
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=60

# ==============================================================================
# 5. Asyncpg Connection Pool Configuration
# ==============================================================================
DB_POOL_MIN_SIZE=20
DB_POOL_MAX_SIZE=100

# ==============================================================================
# 6. Pipeline Settings (Medallion Daemon)
# ==============================================================================
PIPELINE_BATCH_SIZE=10000
PIPELINE_INTERVAL_SECONDS=90

# ==============================================================================
# 7. Django Web UI Settings
# ==============================================================================
SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# ==============================================================================
# 8. Uvicorn Server Mode (Dev vs High-Throughput Benchmark)
# ==============================================================================
UVICORN_EXTRA_ARGS=--reload
