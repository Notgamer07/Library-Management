# ==============================================================================
# Enterprise Decoupled Library Management System - Environment Variables Template
# Copy this file to .env and replace placeholders with your secrets.
# ==============================================================================

# PostgreSQL 16 Configuration
POSTGRES_DB=library_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=db_postgres
POSTGRES_PORT=5432

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=60

# Asyncpg Pool Sizing (~1000 req/sec Target)
DB_POOL_MIN_SIZE=20
DB_POOL_MAX_SIZE=100

# Django Web UI Settings
SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=True
ALLOWED_HOSTS=*
