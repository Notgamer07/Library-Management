FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (postgresql client libs only; mysql dropped)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY . .

EXPOSE 8000

# 4 workers saturates asyncpg pool and handles ~1000 req/sec on a 4-core host.
# Each worker gets its own asyncpg connection pool (max_size=100 per worker).
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--loop", "uvloop"]
